OPENAI_API_KEY=replace-with-a-local-development-key

# Small model used by every LangGraph completion and classifier node.
OPENAI_MODEL=gpt-4.1-nano

PG_DSN=postgresql://rag:rag@localhost:5432/rag

# The LangGraph answer-grounding classifier must meet this 0-1 threshold.
RAG_CONFIDENCE_THRESHOLD=0.5

# Lower values reduce generation variability. Must be between 0 and 2.
RAG_TEMPERATURE=0.1

# Comma-separated browser origins allowed to call FastAPI.
RAG_CORS_ORIGINS=http://localhost:4321,http://127.0.0.1:4321
